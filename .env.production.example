# Public HTTPS address. A DuckDNS subdomain works without buying a domain.
SITE_ADDRESS=your-zerotrash-name.duckdns.org
PUBLIC_ORIGIN=https://your-zerotrash-name.duckdns.org

# Created only on the first start of a new production database.
ADMIN_NAME=ZeroTrash Admin
ADMIN_EMAIL=admin@yourcollege.edu
ADMIN_PASSWORD=replace-with-a-long-random-password

# Production safety settings.
SEED_DEMO_USERS=false
SESSION_COOKIE_SECURE=true

# Keep GPS bypassed for now. Change both to true and rebuild when ready.
NEXT_PUBLIC_PHOTO_LOCATION_ENABLED=false
REQUIRE_PHOTO_LOCATION=false
